def _strip_inline(md):
    text = str(md or '')
    text = re.sub(r'`([^`]+)`', r'\1', text)
    text = re.sub(r'\*\*([^*]+)\*\*', r'\1', text)
    text = re.sub(r'\*([^*]+)\*', r'\1', text)
    text = re.sub(r'\[([^\]]+)\]\([^)]+\)', r'\1', text)
    return text.strip()

def _short_text(text, limit=120):
    text = re.sub(r'\s+', ' ', _strip_inline(text)).strip()
    if len(text) <= limit:
        return text
    return text[: max(0, limit - 1)].rstrip("，。；、,. ") + "…"

def _split_source_suffix(text):
    raw = _strip_inline(text)
    m = re.match(r'^(.*)（([^（）]+)）\s*$', raw)
    if m and re.search(r'(agent-memory|notes/|wiki/|raw/|source\.md|日报|Claude|OpenClaw)', m.group(2), re.I):
        return m.group(1).strip(), m.group(2).strip()
    return raw, "日报自动汇总"

def _parse_table_rows(section):
    rows = []
    for line in str(section or '').splitlines():
        line = line.strip()
        if not line.startswith('|') or re.match(r'^\|\s*-', line):
            continue
        cells = [c.strip() for c in line.strip('|').split('|')]
        if len(cells) >= 3 and cells[0] != '指标':
            rows.append({'label': _strip_inline(cells[0]), 'value': _strip_inline(cells[1]), 'note': _strip_inline(cells[2])})
    return rows

def _parse_ai_work_daily_cards(section):
    cards = []
    parts = re.split(r'^###\s+', str(section or ''), flags=re.M)
    for part in parts:
        part = part.strip()
        if not part:
            continue
        lines = part.splitlines()
        heading = _strip_inline(lines[0])
        m = re.match(r'^(?:\d+[.)]\s*)?(.+)$', heading)
        label = m.group(1).strip() if m else heading
        card = {'label': label, 'what': '', 'keywords': '', 'detail': '', 'why': '', 'source': ''}
        for line in lines[1:]:
            lm = re.match(r'^\s*[-*+]\s*\*\*([^*]+)：\*\*\s*(.*?)\s*$', line)
            if not lm:
                lm = re.match(r'^\s*[-*+]\s*([^:：]+)[:：]\s*(.*?)\s*$', line)
            if not lm:
                continue
            key, val = lm.group(1).strip(), _strip_inline(lm.group(2))
            if '一句话' in key or '发生' in key:
                card['what'] = val
            elif '关键词' in key:
                card['keywords'] = val
            elif '详情' in key:
                card['detail'] = val
            elif '为什么' in key or '重要' in key:
                card['why'] = val
            elif '证据' in key or '来源' in key:
                card['source'] = val
        if card['what'] or card['why'] or card['detail']:
            cards.append(card)
    return cards

def _parse_ai_work_daily_triage(section):
    data = {}
    current = None
    for raw in str(section or '').splitlines():
        h = re.match(r'^###\s+(.+?)\s*$', raw.strip())
        if h:
            current = _strip_inline(h.group(1))
            data[current] = []
            continue
        m = re.match(r'^\s*[-*+]\s+(.+?)\s*$', raw)
        if m and current:
            text, source = _split_source_suffix(m.group(1))
            if text and text != '暂无明确记录。':
                data[current].append((text, source))
    return data

def _parse_ai_work_daily_details(section):
    details = []
    current = None
    rows = []
    for raw in str(section or '').splitlines():
        h = re.match(r'^###\s+(.+?)\s*$', raw.strip())
        if h:
            if current is not None:
                details.append((current, rows))
            current = _strip_inline(h.group(1))
            rows = []
            continue
        m = re.match(r'^\s*[-*+]\s+(.+?)\s*$', raw)
        if m and current:
            text, source = _split_source_suffix(m.group(1))
            if text and text != '暂无明确记录。':
                rows.append((text, source))
    if current is not None:
        details.append((current, rows))
    return details

def _render_ai_daily_list(rows, limit=4):
    rows = (rows or [])[:limit]
    if not rows:
        return '<p class="empty">暂无明确记录。</p>'
    return '<ul>' + ''.join(
        f'<li><span>{_render_inline(_short_text(text, 128))}</span><small>{_esc(source or "日报自动汇总")}</small></li>'
        for text, source in rows
    ) + '</ul>'

