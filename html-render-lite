    triage = _parse_ai_work_daily_triage(_section_text(content, '风险 / 决策 / 下一步'))
    details = _parse_ai_work_daily_details(_section_text(content, '详细记录'))
    details_html = ''.join(
        f'<details><summary>{_render_inline(name)}<span>{len(rows)}</span></summary>{_render_ai_daily_list(rows, 20)}</details>'
        for name, rows in details
    ) or '<p class="empty">暂无详细记录。</p>'
    source_rows = _list_items(_section_text(content, '来源'))
    source = source_rows[0].strip('`') if source_rows else 'source.md'
    return (f'<!doctype html><html lang="zh-CN"><head><meta charset="utf-8">'
            f'<meta name="viewport" content="width=device-width, initial-scale=1">'
            f'<title>{_esc(clean_title + ("｜" + day if day else ""))}</title><style>{css}</style></head><body>'
            f'<main class="wrap"><section class="hero"><div class="hero-main"><div class="eyebrow">AI Work Daily / Visual Briefing</div>'
            f'<h1>{_render_inline(clean_title)}</h1><div class="date-mark">{_esc(day)}</div><p class="lead">{_render_inline(lead)}</p></div>'
            f'<aside class="hero-side"><h2>今日主线</h2><p class="mainline">{_render_inline(mainline)}</p><p class="source">Source: {_esc(source)}</p></aside></section>'
            f'<section class="metrics" aria-label="今日看板">{metric_html}</section>'
