def _parse_ai_work_done_items(section):
    items = []
    for raw in str(section or '').splitlines():
        m = re.match(r'^\s*(?:[-*+]|\d+[.)])\s+(.+?)\s*$', raw)
        if not m:
            continue
        text, source = _split_source_suffix(m.group(1))
        text = _short_text(text, 120)
        if not text or text == '暂无明确已办事项。':
            continue
        project = '其他'
        pm = re.match(r'^([^:：]{2,32})[:：]\s*(.+)$', text)
        if pm:
            project = _strip_inline(pm.group(1)).strip()
            text = pm.group(2).strip()
        items.append({'project': project or '其他', 'text': text, 'source': source})
    return items

def _group_ai_work_done_items(items):
    groups = []
    index = {}
    for item in items:
        project = item.get('project') or '其他'
        if project not in index:
            index[project] = {'project': project, 'items': []}
            groups.append(index[project])
        index[project]['items'].append(item)
    return groups

