            f'<article class="panel"><h3>风险提醒</h3>{_render_ai_daily_list(triage.get("风险提醒"))}</article>'
            f'<article class="panel"><h3>建议下一步</h3>{_render_ai_daily_list((triage.get("建议下一步") or []) + (triage.get("仍在推进") or []))}</article></section>'
            f'<section class="section-title"><h2>详细记录</h2><p>需要追证据时再展开</p></section>'
